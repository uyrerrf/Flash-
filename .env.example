# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Auth (CHANGE BEFORE DEPLOYING) ───────────────────────────────────────────
ADMIN_USER=admin
ADMIN_PASS=changeme_strong_password_here

# ── Session (generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))") ──
SESSION_SECRET=replace_with_64_char_random_string

# ── Database ──────────────────────────────────────────────────────────────────
DB_PATH=./data/nexus.db
