<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme — inherits from Material3 (provided by material dependency) -->
    <style name="Theme.App" parent="Theme.Material3.DayNight" />

    <!-- No-action-bar variant used by most activities -->
    <style name="Theme.App.NoActionBar" parent="Theme.Material3.DayNight.NoActionBar" />

    <!-- Translucent for permission/overlay activities -->
    <style name="Theme.App.Translucent" parent="android:Theme.Translucent.NoTitleBar" />

    <!-- Fullscreen for studio/VNC -->
    <style name="Theme.App.Fullscreen" parent="android:Theme.NoTitleBar.Fullscreen" />

    <!-- Splash screen (required for Android 12+) -->
    <style name="Theme.App.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/black</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.App.NoActionBar</item>
    </style>
</resources>
